      ],
      "id": "548bca12-4337-4384-9279-b0973147d768",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "L1E0HmgtN6lxkUvC",
          "name": "Google Gemini(PaLM) Api account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Turn each AI reply (text) back into a proper row\nconst original = $('Extract from File').all();\n\nreturn $input.all().map((item, i) => {\n  let raw = (item.json.text || '').trim();\n  // Remove ```json fences if the model added them\n  raw = raw.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '');\n  try {\n    return { json: JSON.parse(raw) };\n  } catch (e) {\n    // If the reply isn't valid JSON, keep the original row and flag it\n    return { json: { ...original[i].json, ai_error: 'Could not parse AI output' } };\n  }\n});"
      },
      "type": "n8n-nodes-base.code",
