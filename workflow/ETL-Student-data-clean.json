    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a data-cleaning assistant. Clean and standardize this student record:\n- Trim extra spaces in all fields\n- Name: Title Case (e.g. \"Arun Kumar\")\n- Email: lowercase; leave empty if invalid\n- Phone: exactly 10 digits only (remove +91, spaces, dashes); leave empty if invalid\n- City: correct spelling in Title Case (e.g. \"Chenai\" → \"Chennai\", \"Bangalor\" → \"Bengaluru\")\n- Date of birth: format YYYY-MM-DD; leave empty if the date is impossible\n- Grade: the number 10\n- Marks: a number from 0 to 100; leave empty if invalid\n\nKeep exactly the same keys. Return ONLY a valid JSON object, no explanation, no code fences.\n\nRecord:\n{{ JSON.stringify($json) }}",
        "batching": {
          "batchSize": 5
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        448,
        0
      ],
      "id": "dafc2a9b-cd3d-49df-99e1-7f133d4f1655",
      "name": "Basic LLM Chain"
    },
    {
